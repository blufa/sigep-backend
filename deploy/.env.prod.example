# Copier en .env.prod sur le VPS (jamais commité) : cp deploy/.env.prod.example .env.prod
# Mêmes règles que lacaeducation/deploy/.env.prod.example : valeurs nouvelles/aléatoires, jamais
# réutiliser celles d'un autre projet.

STACK=sigep-prod
GHCR_OWNER=<ton-pseudo-ou-organisation-github>
BACKEND_TAG=prod
FRONTEND_TAG=prod

POSTGRES_DB=sigep_prod
POSTGRES_USER=sigep_prod
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort

# Génère avec : openssl rand -base64 64
JWT_SECRET=change-moi-chaine-aleatoire-longue
JWT_EXPIRATION_MINUTES=480

FRONT_URL=https://infrastructure.jeccamtech.com
