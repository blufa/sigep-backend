# Variables d'environnement lues par application.yaml (Spring Boot).
# Copier en .env et exporter dans le shell avant de lancer ./mvnw spring-boot:run,
# ou les définir directement dans la configuration de déploiement (Docker, systemd, etc.).

DB_URL=jdbc:postgresql://localhost:5432/sigep
DB_USER=blufa
DB_PASSWORD=blufa

SERVER_PORT=8085

# Secret de signature des JWT (HS256) — à changer en production, >= 32 caractères.
JWT_SECRET=bcmKuc7FJvT1O3sJoXPy/IBQ4JtALoyL3h+eehA0Fz7WiHGDF26jVC94S+zFsu63X90T6fsjht0bOfF/VWCbXQ==
JWT_EXPIRATION_MINUTES=480

