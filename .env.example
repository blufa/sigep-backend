# Variables d'environnement lues par application.yaml (Spring Boot).
# Copier en .env et exporter dans le shell avant de lancer ./mvnw spring-boot:run,
# ou les définir directement dans la configuration de déploiement (Docker, systemd, etc.).

DB_URL=jdbc:postgresql://localhost:5432/sigep
DB_USER=blufa
DB_PASSWORD=blufa

SERVER_PORT=8085

# Secret de signature des JWT (HS256) — à changer en production, >= 32 caractères.
JWT_SECRET=bcmKuc7FJvT1O3sJoXPy/IBQ4JtALoyL3h+eehA0Fz7WiHGDF26jVC94S+zFsu63X90T6fsjht0bOfF/VWCbXQ==
JWT_EXPIRATION_MINUTES=480

# Origines autorisées pour les appels CORS depuis sigep-ui (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:3100

# NimbaSMS (fournisseur SMS guinéen) — utilisé par le cron d'absence (12h) et les convocations de
# réunion. Tant que NIMBA_SMS_SERVICE_ID/SECRET_TOKEN/SENDER_NAME ne sont pas renseignés, les SMS
# sont seulement journalisés, jamais réellement envoyés (voir NimbaSmsGateway).
NIMBA_SMS_ENABLED=true
NIMBA_SMS_SERVICE_ID=
NIMBA_SMS_SECRET_TOKEN=
NIMBA_SMS_SENDER_NAME=
NIMBA_SMS_BASE_URL=https://api.nimbasms.com
NIMBA_SMS_DEFAULT_DIALING=224
